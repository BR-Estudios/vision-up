{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": "src",
    "paths": {
      "@types": ["@types/"],
      "@assets": ["assets/"],
      "@app": ["app/"],
      "@components/*": ["components/*"],
      "@contexts": ["contexts/"],
      "@data/*": ["data/*"],
      "@hooks": ["hooks/"],
      "@navigation": ["navigation/"],
      "@services": ["services/"],
      "@theme/*": ["theme/*"],
      "@utils/*": ["utils/*"],
      "@views": ["views/"]
    }
  }
}
